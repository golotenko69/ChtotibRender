# ---- Django core ----
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Europe/Moscow

# ---- PostgreSQL ----
POSTGRES_DB=printshop
POSTGRES_USER=printshop
POSTGRES_PASSWORD=printshop
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---- Email ----
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=user@example.com
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.com
ADMIN_EMAIL=admin@example.com

# ---- Shop contacts shown to clients ----
SHOP_PHONE=+7 (900) 000-00-00
SHOP_EMAIL=hello@your-domain.example
# Telegram username without @ (leave empty to open Telegram by phone)
SHOP_TELEGRAM=
# WhatsApp number (leave empty to use SHOP_PHONE)
SHOP_WHATSAPP=
SHOP_ADDRESS=г. Москва, ул. Примерная, д. 1
SHOP_HOURS=Пн–Пт: 10:00–19:00

# ---- Uploads ----
MAX_IMAGE_UPLOAD_MB=10
MAX_MODEL_UPLOAD_MB=100

# ---- Production only ----
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
CSRF_TRUSTED_ORIGINS=https://your-domain.example

# ---- Docker image (used by docker-compose.prod.yml / CD) ----
IMAGE_NAME=ghcr.io/golotenko69/chtotibrender
IMAGE_TAG=latest
